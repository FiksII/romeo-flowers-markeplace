# Local values; never commit the real .env file.
DEBUG=True
SECRET_KEY=local-only-marketplace-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://romeo:CHANGE_ME@127.0.0.1:5432/romeo_marketplace
DADATA_TOKEN=
# A key enables live addresses even with demo orders. True keeps fixture addresses.
ADDRESS_DEMO=False
# Public browser key for Yandex Tiles API; restrict it by site HTTP Referer.
YANDEX_TILES_API_KEY=
# Enable only behind a proxy that removes incoming X-Forwarded-Proto headers.
TRUST_PROXY_HTTPS=False

# Beget S3 for product photos. Enable after filling in both access keys.
S3_ENABLED=False
S3_BUCKET_NAME=fe3d692e570c-flowersstorage
S3_ENDPOINT_URL=https://s3.ru1.storage.beget.cloud
S3_REGION_NAME=ru1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_LOCATION=media
# Keep signed URLs for a private bucket. False requires public read access.
S3_QUERYSTRING_AUTH=True
